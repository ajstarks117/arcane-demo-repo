+def validate_token(token: str) -> dict | None:
+    """
+    Validates a JWT token and returns its payload if valid, otherwise None.
+    Addresses incorrect validation of JWT expiration timestamp leading to premature session termination.
+    """
+    try:
+        # The 'leeway' parameter allows for a small clock skew between the token issuer
+        # and the token verifier, preventing premature expiration errors.
+        # A common value is 5-10 seconds. This directly addresses "premature session termination"
+        # by making the expiration check more tolerant to minor time differences.
+        payload = jwt.decode(token, SECRET_KEY, algorithms=["HS256"], leeway=10)
+        return payload
+    except jwt.ExpiredSignatureError:
+        # Token has expired. With the added leeway, this should now only trigger for genuinely expired tokens.
+        return None
+    except jwt.InvalidTokenError:
+        # Token is invalid for other reasons (e.g., bad signature, malformed token).
+        return None
